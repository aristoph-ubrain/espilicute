# Copie este arquivo para .env.local e preencha os valores.
# Na Vercel, cadastre as mesmas variáveis em Project Settings > Environment Variables.

# String de conexão do MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI="mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Nome do banco de dados
MONGODB_DB="espilicute"

# Senha de acesso ao painel /admin (use uma senha forte)
ADMIN_PASSWORD=""
# Segredo usado para assinar o cookie de sessão do painel.
# Gere um valor aleatório longo, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Token do Vercel Blob para upload de fotos.
# Na Vercel ele é criado automaticamente ao conectar um Blob Store ao projeto (Storage > Blob).
BLOB_READ_WRITE_TOKEN=""

# Endereço público da loja (usado no sitemap e nas tags de compartilhamento)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
